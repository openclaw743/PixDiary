# PixDiary backend — required env vars (no real values)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres (used by pg Pool + migration runner)
DATABASE_URL=postgres://pixdiary:pixdiary@localhost:5432/pixdiary

# JWT / auth (HS256). Use a 256-bit random secret in production.
JWT_SECRET=change-me-please-use-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900       # 15 minutes
JWT_REFRESH_TTL_SECONDS=604800   # 7 days
BCRYPT_COST=12

# CORS allowlist (comma-separated). Frontend origins.
CORS_ORIGINS=http://localhost:5173

# Rate limit knobs (per-IP for auth)
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_GENERAL_PER_MIN=600
